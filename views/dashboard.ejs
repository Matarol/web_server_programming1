<!DOCTYPE html>
<html lang="en">
<%- include('includes/head') %>
<body>
    <%- include('includes/header') %>
    <main>
        <% if (posts.length == 0) { %>
            <h4>Hej <%= user.username %>, dina inlägg kommer sparas här nedanför!</h4>
        <% } else { %>
       <h4>Hej <%= user.username %>, här är dina inlägg!</h4>
       <% } %>
       
       <ul>
        <% posts.forEach(post => { %>
            <li><a href="/post/<%= post.id %>"> <%= post.title %> </a><span>-</span> skapat <%= new Date(post.createdDate).getFullYear() %> <%= new Date(post.createdDate).getMonth() +1 %> <%= new Date(post.createdDate).getDate() %></li>

        <% })  %>
       </ul>
       
    </main>
    <%- include('includes/footer') %>
    
</body>
</html>