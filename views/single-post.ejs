<!DOCTYPE html>
<html lang="en">
<%- include('includes/head') %>
<body>
    <%- include('includes/header') %>
    <main>
        <h1><%= post.title %></h1>

        <article>
            <small>inlägg av: <%= post.username %> postat: <%= new Date(post.createdDate).getFullYear() %> <%= new Date(post.createdDate).getMonth() +1 %> <%= new Date(post.createdDate).getDate() %></small>

            <div>
                <p><%- filterUserHTML(post.body) %></p>

            </div>


        </article>

        <% if (isAuthor) { %>
        <a href="/edit-post/<%= post.id %>" class="button">Uppdatera!</a>

        <form style="display: inline;" action="/delete-post/<%= post.id %>" method="POST">
            <button>Radera!</button>
        </form>
        <% } %>

        
    </main>
    <%- include('includes/footer') %>
    
</body>
</html>